{
  "name": "@gala-chain/test-e2e",
  "version": "3.2.5",
  "description": "E2E test clients for GalaChain",
  "license": "Apache-2.0",
  "dependencies": {
    "@gala-chain/api": "3.2.5",
    "@gala-chain/client": "3.2.5",
    "@gala-chain/test": "3.2.5",
    "@jest/globals": "29.7.0",
    "tslib": "^2.6.2"
  },
  "peerDependencies": {
    "bignumber.js": "*",
    "class-transformer": "0.5.1",
    "fabric-contract-api": "*"
  },
  "type": "commonjs",
  "main": "./lib/src/index.js",
  "typings": "./lib/src/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "tsc -b --clean",
    "build": "tsc -b",
    "build:watch": "tsc -b -w",
    "madge": "madge --circular --warning lib",
    "lint": "nx run lint",
    "fix": "nx run lint --fix",
    "prepublishOnly": "npm i && npm run clean && npm run build && npm run lint && npm run madge",
    "format": "prettier --config ../.prettierrc 'src/**/*.ts' --write",
    "test": "jest"
  }
}
